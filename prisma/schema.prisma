// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum UnitKind {
  PIECE
  WEIGHT
  LENGTH
  VOLUME
  PACK
  OTHER
}

enum BarcodeType {
  PRODUCT
  PACK
  INTERNAL
  SUPPLIER
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  RETURNED
}

/// Stored lifecycle. EXPIRED is derived when an ISSUED quotation is past validUntil.
enum QuotationStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum SalePaymentMethod {
  CASH
  ONLINE_BANKING
}

enum PromotionScope {
  CART
  PRODUCT
  CATEGORY
}

enum StockMovementType {
  OPENING
  PURCHASE_IN
  SALE_OUT
  SALE_RETURN_IN
  PURCHASE_RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE_OUT
  WASTAGE_OUT
  RECOUNT_IN
  RECOUNT_OUT
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)

  createdPurchases Purchase[]        @relation("PurchaseCreatedBy")
  createdSales     Sale[]            @relation("SaleCreatedBy")
  stockMovements   StockMovement[]
  stockAdjustments StockAdjustment[]
  salePayments      SalePayment[]
  purchasePayments  PurchasePayment[]
  createdQuotations Quotation[]      @relation("QuotationCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive])
}

model Supplier {
  id            String  @id @default(cuid())
  name          String  @unique
  contactPerson String?
  phone         String? @unique
  email         String?
  address       String?
  gstNumber     String?
  note          String?

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id          String  @id @default(cuid())
  name        String
  phone       String? @unique
  email       String?
  address     String?
  partyGstNo  String?
  /// State / place (e.g. for tax invoice bill-to).
  partyState  String?

  sales      Sale[]
  quotations Quotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Product {
  id          String        @id @default(cuid())
  sku         String        @unique
  name        String
  slug        String?       @unique
  description String?
  category    String?
  brand       String?
  /// Unique case-insensitively when non-blank (see migration Product_brandCode_lower_key).
  brandCode   String?
  color       String?
  /// Physical size / dimension label (e.g. 10mm, 500ml) — optional.
  size        String?
  /// Harmonized System of Nomenclature (GST), e.g. 4/6/8 digit code
  hsnCode     String?
  status      ProductStatus @default(ACTIVE)

  baseUnitCode     String
  unitKind         UnitKind
  allowsFractional Boolean  @default(false)

  costPrice    Decimal? @db.Decimal(14, 4)
  /// Moving weighted-average cost of stock on hand (for margin/valuation, not pricing).
  avgCostPrice Decimal? @db.Decimal(14, 4)
  percentage   Decimal? @db.Decimal(8, 4)
  mrp          Decimal? @db.Decimal(14, 4)
  sellingPrice Decimal? @db.Decimal(14, 4)
  cgstPercent  Decimal? @db.Decimal(5, 2)
  sgstPercent  Decimal? @db.Decimal(5, 2)
  igstPercent  Decimal? @db.Decimal(5, 2)

  /// Set when a purchase came in cheaper: selling price kept, owner should review.
  priceReviewNeeded     Boolean  @default(false)
  /// Suggested selling price (from markup on the new lower cost) awaiting owner approval.
  suggestedSellingPrice Decimal? @db.Decimal(14, 4)
  /// Human-readable reason for the pending price review.
  priceReviewNote       String?

  reorderLevel Decimal? @db.Decimal(14, 4)
  currentStock Decimal  @default(0) @db.Decimal(18, 4)

  barcodes         Barcode[]
  units            ProductUnit[]
  purchaseLines    PurchaseLine[]
  saleLines        SaleLine[]
  quotationLines   QuotationLine[]
  stockMovements   StockMovement[]
  stockAdjustments StockAdjustment[]
  promotionLinks   PromotionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([brand])
  @@index([status])
}

model Promotion {
  id         String         @id @default(cuid())
  name       String
  code       String?        @unique
  scope      PromotionScope
  category   String?
  percentage Decimal        @db.Decimal(5, 2)
  isActive   Boolean        @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  note       String?

  products  PromotionProduct[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([scope, isActive])
  @@index([category])
}

model PromotionProduct {
  id          String    @id @default(cuid())
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([promotionId, productId])
  @@index([productId])
}

model ProductUnit {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  code        String
  displayName String
  isBaseUnit  Boolean @default(false)

  conversionToBase     Decimal @db.Decimal(18, 4)
  allowsFractionalSale Boolean @default(false)

  barcodes       Barcode[]
  purchaseLines  PurchaseLine[]
  saleLines      SaleLine[]
  quotationLines QuotationLine[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, code])
  @@index([productId, isBaseUnit])
}

model Barcode {
  id   String      @id @default(cuid())
  code String      @unique
  type BarcodeType @default(PRODUCT)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productUnitId String?
  productUnit   ProductUnit? @relation(fields: [productUnitId], references: [id], onDelete: SetNull)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([productUnitId])
}

model Purchase {
  id             String   @id @default(cuid())
  purchaseNumber String   @unique
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id])

  status        PurchaseStatus @default(DRAFT)
  invoiceNumber String?
  invoiceDate   DateTime?
  note          String?

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal @default(0) @db.Decimal(14, 2)
  balanceAmount  Decimal @default(0) @db.Decimal(14, 2)

  createdById String
  createdBy   User   @relation("PurchaseCreatedBy", fields: [createdById], references: [id])

  lines          PurchaseLine[]
  stockMovements StockMovement[]
  payments       PurchasePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId, status])
  @@index([invoiceDate])
}

model PurchasePayment {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(14, 2)
  /// When the payment was made (can differ from createdAt if backdated).
  paidAt      DateTime @default(now())
  note        String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([purchaseId, paidAt])
  @@index([createdById])
}

model PurchaseLine {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productUnitId String
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [id])

  quantity       Decimal @db.Decimal(18, 4)
  quantityInBase Decimal @db.Decimal(18, 4)

  unitCost     Decimal @db.Decimal(14, 4)
  lineDiscount Decimal @default(0) @db.Decimal(14, 2)
  lineTax      Decimal @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
  @@index([productId])
}

model Sale {
  id         String @id @default(cuid())
  saleNumber String @unique

  status               SaleStatus @default(DRAFT)
  customerName         String?
  customerPhone        String?
  customerId           String?
  customer             Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerNameSnapshot String?
  /// Snapshot for invoices (walk-in Party GST or copied from customer at sale time).
  customerPartyGstNo   String?
  /// State / place for tax invoice (walk-in or copied from customer at sale time).
  customerPartyState   String?

  note String?

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 2)
  /// Freight / transport (added to charged total; not per line item).
  transportAmount Decimal @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal @default(0) @db.Decimal(14, 2)
  balanceAmount  Decimal @default(0) @db.Decimal(14, 2)

  createdById String
  createdBy   User   @relation("SaleCreatedBy", fields: [createdById], references: [id])

  lines          SaleLine[]
  stockMovements StockMovement[]
  payments       SalePayment[]
  /// Reserved for a future quotation-to-sale conversion. Unused by sale posting.
  convertedFromQuotation Quotation? @relation("QuotationConversion")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([customerId])
}

model SalePayment {
  id          String            @id @default(cuid())
  saleId      String
  sale        Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount      Decimal           @db.Decimal(14, 2)
  method      SalePaymentMethod @default(CASH)
  note        String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([saleId, createdAt])
}

model SaleLine {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productUnitId String
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [id])

  quantity       Decimal @db.Decimal(18, 4)
  quantityInBase Decimal @db.Decimal(18, 4)

  unitPrice    Decimal @db.Decimal(14, 4)
  lineDiscount Decimal @default(0) @db.Decimal(14, 2)
  lineTax      Decimal @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
}

/// Per-calendar-year sequence for QUO-YYYY-####. Row-locked inside the create transaction.
model QuotationCounter {
  year       Int @id
  lastNumber Int @default(0)
}

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status          QuotationStatus @default(DRAFT)
  /// Calendar date in Asia/Kolkata (stored as a date, not the browser clock).
  quotationDate   DateTime        @db.Date
  validUntil      DateTime        @db.Date

  customerName          String
  customerContactPerson String?
  customerPhone         String?
  customerEmail         String?
  customerAddress       String?
  customerPartyGstNo    String?
  customerPartyState    String?

  /// When false, tax amounts are zero. Line GST percents are still snapshotted.
  includeGst Boolean @default(true)

  /// Order-level percent applied when the quotation was last priced (0–100).
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  subtotal        Decimal @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal @default(0) @db.Decimal(14, 2)
  taxableAmount   Decimal @default(0) @db.Decimal(14, 2)
  cgstAmount      Decimal @default(0) @db.Decimal(14, 2)
  sgstAmount      Decimal @default(0) @db.Decimal(14, 2)
  igstAmount      Decimal @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal @default(0) @db.Decimal(14, 2)
  transportAmount Decimal @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal @default(0) @db.Decimal(14, 2)

  note String?

  createdById String
  createdBy   User   @relation("QuotationCreatedBy", fields: [createdById], references: [id])

  /// Optional hook so a future conversion can point at a normal Sale. Not set by this feature.
  convertedSaleId String? @unique
  convertedSale   Sale?   @relation("QuotationConversion", fields: [convertedSaleId], references: [id], onDelete: SetNull)

  lines QuotationLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([quotationDate])
  @@index([validUntil])
  @@index([createdById])
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productUnitId String?
  productUnit   ProductUnit? @relation(fields: [productUnitId], references: [id], onDelete: SetNull)

  quantity       Decimal @db.Decimal(18, 4)
  quantityInBase Decimal @db.Decimal(18, 4)

  unitPrice    Decimal @db.Decimal(14, 4)
  lineDiscount Decimal @default(0) @db.Decimal(14, 2)
  lineTax      Decimal @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal @db.Decimal(14, 2)

  productName     String
  sku             String
  description     String?
  hsnCode         String?
  unitCode        String
  unitDisplayName String
  cgstPercent     Decimal @default(0) @db.Decimal(5, 2)
  sgstPercent     Decimal @default(0) @db.Decimal(5, 2)
  igstPercent     Decimal @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId])
  @@index([productId])
  @@index([productUnitId])
}

model StockMovement {
  id   String            @id @default(cuid())
  type StockMovementType

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productUnitId String?
  productUnit   ProductUnit? @relation(fields: [productUnitId], references: [id])

  quantity       Decimal @db.Decimal(18, 4)
  quantityInBase Decimal @db.Decimal(18, 4)

  note String?

  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([purchaseId])
  @@index([saleId])
}

model StockAdjustment {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantityBefore Decimal @db.Decimal(18, 4)
  quantityAfter  Decimal @db.Decimal(18, 4)
  difference     Decimal @db.Decimal(18, 4)

  reason String
  note   String?

  adjustedById String
  adjustedBy   User   @relation(fields: [adjustedById], references: [id])

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([adjustedById, createdAt])
}

enum ScheduledReportType {
  SALES
  INVENTORY
  SUPPLIER_OUTSTANDING
  CUSTOMER_OUTSTANDING
}

enum ReportPeriod {
  DAILY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ReportRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model ReportScheduleConfig {
  id                         String        @id @default("default")
  notifyEmail                String        @default("")
  salesEnabled               Boolean       @default(false)
  salesPeriod                ReportPeriod?
  inventoryEnabled           Boolean       @default(false)
  inventoryPeriod            ReportPeriod?
  supplierOutstandingEnabled Boolean       @default(false)
  supplierOutstandingPeriod  ReportPeriod?
  customerOutstandingEnabled Boolean       @default(false)
  customerOutstandingPeriod  ReportPeriod?
  updatedAt                  DateTime      @updatedAt
}

model ReportRun {
  id           String              @id @default(cuid())
  reportType   ScheduledReportType
  period       ReportPeriod
  periodStart  DateTime
  periodEnd    DateTime
  asOf         DateTime
  status       ReportRunStatus
  payload      Json?
  errorMessage String?
  emailSentAt  DateTime?
  createdAt    DateTime            @default(now())

  @@unique([reportType, period, periodStart])
  @@index([createdAt])
  @@index([reportType, status])
}
