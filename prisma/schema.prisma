// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum UnitKind {
  PIECE
  WEIGHT
  LENGTH
  VOLUME
  PACK
  OTHER
}

enum BarcodeType {
  PRODUCT
  PACK
  INTERNAL
  SUPPLIER
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  RETURNED
}

enum PromotionScope {
  CART
  PRODUCT
  CATEGORY
}

enum StockMovementType {
  OPENING
  PURCHASE_IN
  SALE_OUT
  SALE_RETURN_IN
  PURCHASE_RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE_OUT
  WASTAGE_OUT
  RECOUNT_IN
  RECOUNT_OUT
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)

  createdPurchases Purchase[]        @relation("PurchaseCreatedBy")
  createdSales     Sale[]            @relation("SaleCreatedBy")
  stockMovements   StockMovement[]
  stockAdjustments StockAdjustment[]
  salePayments     SalePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive])
}

model Supplier {
  id            String  @id @default(cuid())
  name          String  @unique
  contactPerson String?
  phone         String? @unique
  email         String?
  address       String?
  gstNumber     String?
  note          String?

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id      String  @id @default(cuid())
  name    String
  phone   String? @unique
  email   String?
  address String?

  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Product {
  id          String        @id @default(cuid())
  sku         String        @unique
  name        String
  slug        String?       @unique
  description String?
  category    String?
  brand       String?
  status      ProductStatus @default(ACTIVE)

  baseUnitCode     String
  unitKind         UnitKind
  allowsFractional Boolean  @default(false)

  costPrice    Decimal? @db.Decimal(14, 4)
  sellingPrice Decimal? @db.Decimal(14, 4)
  taxRate      Decimal? @db.Decimal(5, 2)

  reorderLevel Decimal? @db.Decimal(14, 4)
  currentStock Decimal  @default(0) @db.Decimal(18, 4)

  barcodes         Barcode[]
  units            ProductUnit[]
  purchaseLines    PurchaseLine[]
  saleLines        SaleLine[]
  stockMovements   StockMovement[]
  stockAdjustments StockAdjustment[]
  promotionLinks   PromotionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([brand])
  @@index([status])
}

model Promotion {
  id         String         @id @default(cuid())
  name       String
  code       String?        @unique
  scope      PromotionScope
  category   String?
  percentage Decimal        @db.Decimal(5, 2)
  isActive   Boolean        @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  note       String?

  products  PromotionProduct[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([scope, isActive])
  @@index([category])
}

model PromotionProduct {
  id          String    @id @default(cuid())
  promotionId String
  productId   String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([promotionId, productId])
  @@index([productId])
}

model ProductUnit {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  code        String
  displayName String
  isBaseUnit  Boolean @default(false)

  conversionToBase     Decimal @db.Decimal(18, 4)
  allowsFractionalSale Boolean @default(false)

  barcodes       Barcode[]
  purchaseLines  PurchaseLine[]
  saleLines      SaleLine[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, code])
  @@index([productId, isBaseUnit])
}

model Barcode {
  id   String      @id @default(cuid())
  code String      @unique
  type BarcodeType @default(PRODUCT)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productUnitId String?
  productUnit   ProductUnit? @relation(fields: [productUnitId], references: [id], onDelete: SetNull)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([productUnitId])
}

model Purchase {
  id             String   @id @default(cuid())
  purchaseNumber String   @unique
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id])

  status        PurchaseStatus @default(DRAFT)
  invoiceNumber String?
  invoiceDate   DateTime?
  note          String?

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal @default(0) @db.Decimal(14, 2)

  createdById String
  createdBy   User   @relation("PurchaseCreatedBy", fields: [createdById], references: [id])

  lines          PurchaseLine[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId, status])
  @@index([invoiceDate])
}

model PurchaseLine {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productUnitId String
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [id])

  quantity       Decimal @db.Decimal(18, 4)
  quantityInBase Decimal @db.Decimal(18, 4)

  unitCost     Decimal @db.Decimal(14, 4)
  lineDiscount Decimal @default(0) @db.Decimal(14, 2)
  lineTax      Decimal @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
  @@index([productId])
}

model Sale {
  id         String @id @default(cuid())
  saleNumber String @unique

  status               SaleStatus @default(DRAFT)
  customerName         String?
  customerPhone        String?
  customerId           String?
  customer             Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerNameSnapshot String?

  note String?

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal @default(0) @db.Decimal(14, 2)
  balanceAmount  Decimal @default(0) @db.Decimal(14, 2)

  createdById String
  createdBy   User   @relation("SaleCreatedBy", fields: [createdById], references: [id])

  lines          SaleLine[]
  stockMovements StockMovement[]
  payments       SalePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([customerId])
}

model SalePayment {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(14, 2)
  note        String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([saleId, createdAt])
}

model SaleLine {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productUnitId String
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [id])

  quantity       Decimal @db.Decimal(18, 4)
  quantityInBase Decimal @db.Decimal(18, 4)

  unitPrice    Decimal @db.Decimal(14, 4)
  lineDiscount Decimal @default(0) @db.Decimal(14, 2)
  lineTax      Decimal @default(0) @db.Decimal(14, 2)
  lineTotal    Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
}

model StockMovement {
  id   String            @id @default(cuid())
  type StockMovementType

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productUnitId String?
  productUnit   ProductUnit? @relation(fields: [productUnitId], references: [id])

  quantity       Decimal @db.Decimal(18, 4)
  quantityInBase Decimal @db.Decimal(18, 4)

  note String?

  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([purchaseId])
  @@index([saleId])
}

model StockAdjustment {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantityBefore Decimal @db.Decimal(18, 4)
  quantityAfter  Decimal @db.Decimal(18, 4)
  difference     Decimal @db.Decimal(18, 4)

  reason String
  note   String?

  adjustedById String
  adjustedBy   User   @relation(fields: [adjustedById], references: [id])

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([adjustedById, createdAt])
}
