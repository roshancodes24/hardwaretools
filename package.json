{
  "name": "hardware-inventory-system",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:web": "npm run dev --prefix frontend",
    "dev:all": "npx --yes concurrently -k -n api,web -c blue,green \"npm run dev\" \"npm run dev --prefix frontend\"",
    "build:frontend": "npm run build --prefix frontend",
    "build:release": "npm run build:frontend && prisma generate",
    "start:prod": "cross-env NODE_ENV=production SERVE_FRONTEND=1 tsx src/server.ts",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "npx --yes tsx prisma/seed.ts",
    "db:clear-catalog": "tsx scripts/clear-catalog.ts",
    "db:backup": "node scripts/backup-database.mjs",
    "db:restore": "node scripts/restore-database.mjs",
    "test:inventory": "tsx src/test-inventory.ts",
    "test:regression": "vitest run tests/regression",
    "test:frontend": "vitest run tests/frontend",
    "test:login": "vitest run tests/regression/login.test.ts tests/regression/login-schema.test.ts",
    "test:regression:watch": "vitest tests/regression",
    "test:regression:writes": "cross-env REGRESSION_WRITES=1 vitest run tests/regression",
    "test:all": "npm run test:regression && npm run test:frontend && npm run test:inventory",
    "test:ci": "npm run test:regression && npm run test:frontend && npm run test:regression:writes"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "npx --yes tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.19.39",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  }
}
