# Copy to `.env` and adjust for your machine.

# PostgreSQL connection (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hardware_inventory

# JWT signing secret — use a long random string in production (required when NODE_ENV=production)
# Tokens are stored in the browser (localStorage) for 7 days; there is no server-side revocation list.
JWT_SECRET=dev-jwt-secret-change-in-production

# development | production
NODE_ENV=development

# Comma-separated browser origins allowed to call the API (production / split dev server).
# Defaults in dev: http://localhost:5173 and http://127.0.0.1:5173
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Login brute-force protection (POST /api/login). Set MAX=0 to disable.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Max JSON body size for bulk imports (default 15mb)
JSON_BODY_LIMIT=15mb

# Serve built frontend from Express on the same port (production)
SERVE_FRONTEND=0

# Scheduled owner reports (06:00 IST cron in API process)
# REPORT_SCHEDULER_ENABLED=1
# REPORT_CRON_IST=0,30 6-8 * * *
# REPORT_NOTIFY_EMAIL=owner@example.com
# APP_PUBLIC_URL=https://shop.example.com

# SMTP for report-ready emails (optional — reports still save without SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Raj Hardware Reports <reports@example.com>"
# SMTP_SECURE=0

# Optional: first sale numbers in each series (default 1000)
# SALE_NUMBER_BILL_START=1000
# SALE_NUMBER_TAX_START=1000
